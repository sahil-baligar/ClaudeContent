  "beats": [
    {
      "vo": "In nineteen forty-eight, more than two million people were cut off inside a city. The only way in was the sky.",
      "caption": "In 1948, more than two million people were cut off inside a city. The only way in was the sky.",
      "camera": {
        "to": [
          51.0,
          12.0
        ],
        "zoom": "globe",
        "tilt": 0
      }
    },
    {
      "vo": "After the Second World War, Germany is split into four zones. Berlin sits deep inside the Soviet zone, and it is split too.",
      "camera": {
        "to": "sovzone",
        "zoom": 4.5,
        "tilt": 25
      },
      "year": 1948,
      "header": {
        "kicker": "1945-1948",
        "title": "A Divided City"
      },
      "highlight": [
        "soviet-zone"
      ],
      "labels": [
        "berlin",
        "sovzone"
      ]
    },
    {
      "vo": "On the twenty-fourth of June, nineteen forty-eight, the Soviets close every road, railway and canal into West Berlin.",
      "caption": "On 24 June 1948, the Soviets close every road, railway and canal into West Berlin.",
      "camera": {
        "to": "berlin",
        "zoom": 1.2,
        "tilt": 32
      },
      "header": {
        "kicker": "24 June 1948",
        "title": "Blockade"
      },
      "highlight": [
        "soviet-zone"
      ],
      "labels": [
        "berlin"
      ],
      "stamp": {
        "text": "Blockade",
        "at": 0.6
      }
    },
    {
      "vo": "The Western Allies answer with aircraft. Three air corridors, each about twenty miles wide, are the only routes allowed in and out.",
      "camera": {
        "to": [
          "frankfurt",
          "hamburg",
          "berlin"
        ],
        "tilt": 28,
        "pad": 1.3
      },
      "header": {
        "kicker": "June 1948",
        "title": "Three Corridors"
      },
      "highlight": [
        "soviet-zone"
      ],
      "labels": [
        "frankfurt",
        "hamburg",
        "buckeburg",
        "berlin"
      ],
      "draw": [
        "south",
        "north",
        {
          "route": "central",
          "delay": 1.0
        }
      ]
    },
    {
      "vo": "Planes land at Tempelhof, Gatow and a brand new airfield at Tegel, at the peak one every few minutes, carrying coal, flour and milk.",
      "camera": {
        "to": "berlin",
        "zoom": 0.45,
        "tilt": 36
      },
      "header": {
        "kicker": "1948-1949",
        "title": "Operation Vittles"
      },
      "labels": [
        "tempelhof",
        "gatow",
        "tegel"
      ],
      "card": {
        "kind": "fact",
        "kicker": "Cargo",
        "title": "Coal, flour, milk",
        "body": "Coal was the heaviest load: fuel for power and heat through the winter.",
        "at": 0.35
      }
    },
    {
      "vo": "On one day in April nineteen forty-nine, the airlift delivers almost thirteen thousand tons.",
      "caption": "On one day in April 1949, the airlift delivers almost 13,000 tons.",
      "camera": {
        "to": [
          "frankfurt",
          "hamburg",
          "berlin"
        ],
        "tilt": 24,
        "pad": 1.4
      },
      "year": 1949,
      "header": {
        "kicker": "16 April 1949",
        "title": "The Easter Parade"
      },
      "card": {
        "kind": "stat",
        "kicker": "In 24 hours",
        "value": 12941,
        "unit": " t",
        "label": "of cargo flown into Berlin",
        "at": 0.3
      }
    },
    {
      "vo": "On the twelfth of May, nineteen forty-nine, the Soviets lift the blockade. The airlift has flown in about two point three million tons.",
      "caption": "On 12 May 1949, the Soviets lift the blockade. The airlift has flown in about 2.3 million tons.",
      "camera": {
        "to": "berlin",
        "zoom": 2.0,
        "tilt": 30
      },
      "header": {
        "kicker": "12 May 1949",
        "title": "Blockade Lifted"
      },
      "labels": [
