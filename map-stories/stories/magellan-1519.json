  "beats": [
    {
      "vo": "Five ships left Spain. Three years later, one came back, and it had sailed all the way around the world.",
      "camera": {
        "to": [
          10.0,
          -30.0
        ],
        "zoom": "globe",
        "tilt": 0
      }
    },
    {
      "vo": "On the twentieth of September, fifteen nineteen, Ferdinand Magellan sails from Sanlucar with five ships and about two hundred and seventy men.",
      "caption": "On 20 September 1519, Ferdinand Magellan sails from Sanlucar with five ships and about 270 men.",
      "camera": {
        "to": "sanlucar",
        "zoom": 6,
        "tilt": 30
      },
      "year": 1519,
      "header": {
        "kicker": "September 1519",
        "title": "Five Ships"
      },
      "labels": [
        "sanlucar"
      ],
      "card": {
        "kind": "stat",
        "kicker": "The fleet",
        "value": 270,
        "label": "men, roughly, on five ships",
        "at": 0.45
      }
    },
    {
      "vo": "He is looking for a way west to the Spice Islands. The fleet crosses the Atlantic and works down the coast of South America.",
      "camera": {
        "to": [
          "sanlucar",
          "rio"
        ],
        "tilt": 20,
        "pad": 1.2
      },
      "header": {
        "kicker": "1519",
        "title": "Across the Atlantic"
      },
      "labels": [
        "rio"
      ],
      "draw": [
        {
          "route": "west",
          "to": 0.2
        }
      ]
    },
    {
      "vo": "They spend a bitter winter at San Julian, then find the passage. It takes over a month to thread the strait that now carries his name.",
      "camera": {
        "move": "follow",
        "route": "west",
        "to": "strait",
        "zoom": 9,
        "tilt": 30
      },
      "year": 1520,
      "header": {
        "kicker": "October-November 1520",
        "title": "The Strait"
      },
      "labels": [
        "julian",
        "strait"
      ],
      "draw": [
        {
          "route": "west",
          "to": 0.33
        }
      ]
    },
    {
      "vo": "Then the Pacific. Nobody knows it is this big. They sail for more than three months without fresh food, and men die of scurvy.",
      "camera": {
        "to": "pacific",
        "zoom": 40,
        "tilt": 10
      },
      "header": {
        "kicker": "1520-1521",
        "title": "The Pacific"
      },
      "labels": [
        "pacific",
        "guam"
      ],
      "draw": [
        {
          "route": "west",
          "to": 0.88
        }
      ],
      "stamp": {
        "text": "98 days",
        "at": 0.7
      }
    },
    {
      "vo": "In the Philippines, Magellan takes sides in a local fight. On the twenty-seventh of April, fifteen twenty-one, he is killed at Mactan.",
      "caption": "In the Philippines, Magellan takes sides in a local fight. On 27 April 1521, he is killed at Mactan.",
      "camera": {
        "to": "mactan",
        "zoom": 5,
        "tilt": 32
      },
      "year": 1521,
      "header": {
        "kicker": "27 April 1521",
        "title": "Mactan"
      },
      "highlight": [
        "Philippines"
      ],
      "labels": [
        "mactan"
      ],
      "draw": [
        {
          "route": "west",
          "to": 1.0
        }
      ],
      "card": {
        "kind": "portrait",
        "name": "Ferdinand Magellan",
        "role": "Captain-general, killed at Mactan",
        "at": 0.3
      }
    },
    {
      "vo": "Juan Sebastian Elcano takes the last good ship, the Victoria, loads it with cloves in the Spice Islands, and keeps going west.",
      "camera": {
        "to": [
          "mactan",
          "tidore"
        ],
        "tilt": 30,
        "pad": 1.8
      },
      "header": {
        "kicker": "1521",
        "title": "The Victoria"
      },
      "labels": [
        "tidore"
      ],
      "draw": [
        {
          "route": "home",
          "to": 0.12
        }
      ]
    },
    {
      "vo": "Across the Indian Ocean, around the Cape of Good Hope, and up the coast of Africa.",
      "camera": {
        "to": [
          "tidore",
          "cape"
        ],
        "tilt": 15,
        "pad": 1.1
      },
      "header": {
